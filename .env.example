# Variables del empleado IA. En GitHub: OPENAI_API_KEY va como SECRET del repo
# (Settings → Secrets and variables → Actions → New repository secret).
# Las demás son opcionales (Variables, no secretos) y tienen valores por defecto.

# Obligatoria para generar (texto + imágenes con OpenAI):
OPENAI_API_KEY=sk-...

# Opcionales (defaults entre paréntesis):
# OPENAI_TEXT_MODEL=gpt-4o          # modelo de texto
# IMAGEN_MODEL=gpt-image-1          # modelo de imagen
# IMAGEN_QUALITY=high               # low | medium | high
# IMAGEN_SIZE=1024x1536             # tamaño (vertical, se recorta a 4:5 con el tratamiento)
